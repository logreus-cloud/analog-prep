# DEMO_MODE=1 -> вместо вызовов модели проигрываются записанные ответы.
# Проверяющему не нужен ваш ключ. Это значение по умолчанию.
DEMO_MODE=1

# Нужен только при DEMO_MODE=0. Ключ бесплатного тарифа Google AI Studio.
GEMINI_API_KEY=
# Идентификатор модели меняется чаще спецификаций — проверить в консоли.
GEMINI_MODEL=gemini-2.0-flash

PORT=3000
